{
  "name": "match-do-saber",
  "private": true,
  "type": "module",
  "productName": "Match do Saber",
  "version": "12.0.2",
  "description": "Match do Saber (Conectando): jogo de checagem de notícias, versão web e desktop offline",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare-assets": "tsx scripts/preparar-assets.ts",
    "predev": "npm run prepare-assets",
    "dev": "vite",
    "prebuild": "npm run prepare-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "sync": "tsx scripts/sync/main.ts",
    "fixture": "tsx scripts/fixture.ts",
    "e2e": "npm run fixture && npm run build && playwright test",
    "desktop": "npm run build && electron .",
    "build:desktop": "tsx scripts/preparar-assets.ts --banco-padrao && npm run build",
    "package:win": "npm run build:desktop && electron-packager . \"Match do Saber\" --platform=win32 --arch=x64 --out=out --overwrite --ignore=\"^/(?!(dist|electron)(/|$)|package\\.json$)\" --ignore=\"\\.test\\.ts$\"",
    "e2e:desktop": "npm run fixture && npm run build && playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "qrcode-generator": "1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "18.4.4",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "33.4.11",
    "googleapis": "188.0.0",
    "jsdom": "30.1.3",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.28.2": true
  }
}
